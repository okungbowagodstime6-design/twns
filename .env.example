NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required later for protected scheduled ingestion and AI processing.
CRON_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=

# Optional Google AdSense settings. Ad slots keep their reserved dimensions until configured.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_LEADERBOARD_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
NEXT_PUBLIC_ADSENSE_INFEED_SLOT=