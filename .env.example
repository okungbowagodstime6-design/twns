NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only. Never expose this value to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Required for protected scheduled ingestion (GitHub Actions -> /api/admin/ingestion/run-due).
# Generate with: openssl rand -hex 32
# Must match the CRON_SECRET repo secret AND the Vercel env var.
CRON_SECRET=replace-with-a-long-random-secret

# Required for RSS article analysis (Gemini). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: OpenAI is only used for editorial synthesis/translation when set.
# Safe to omit if you use Gemini only.
# OPENAI_API_KEY=

# Required for breaking-news emails (Resend). Get one at https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sending domain in Resend.
RESEND_FROM_EMAIL=news@yourdomain.com

# Required for the breaking-news webhook (POST /api/notifications/breaking).
# Generate with: openssl rand -hex 32
# Callers send it as the x-twns-webhook-secret header.
TWNS_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Public production URL, e.g. https://twns.vercel.app
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional Google AdSense settings. Ad slots keep their reserved dimensions until configured.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_LEADERBOARD_SLOT=
NEXT_PUBLIC_ADSENSE_SIDEBAR_SLOT=
NEXT_PUBLIC_ADSENSE_INFEED_SLOT=
